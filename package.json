{
  "name": "dsh-plugin-git-blame",
  "version": "0.1.0",
  "description": "Hover the blame gutter in a right-sidebar file preview to see each line's git blame.",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "git-blame",
    "blame"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badpx/dsh-plugin-git-blame.git"
  },
  "homepage": "https://github.com/badpx/dsh-plugin-git-blame#readme",
  "bugs": {
    "url": "https://github.com/badpx/dsh-plugin-git-blame/issues"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
